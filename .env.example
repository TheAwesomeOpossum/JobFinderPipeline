# Google Custom Search
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_cse_id

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Salesforce (username+password flow)
SF_USERNAME=your.email@example.com
SF_PASSWORD=your_sf_password
SF_SECURITY_TOKEN=your_security_token
SF_DOMAIN=login

# PostgreSQL (reuse Salesforce_Backup DB)
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=salesforce_backup
PG_USER=sfuser
PG_PASSWORD=your_pg_password
PG_SSLMODE=require

# Pipeline tuning
DAILY_LIMIT=20
DEFAULT_KEYWORDS=Software Developer,Software Engineer
LOCATION_PREFERENCE=Remote
SENIORITY_TARGETS=mid,senior
# Minimum annual salary threshold — jobs whose known max salary is below this are excluded
# Set to 0 to disable (default). Example: 100000 = $100k
MIN_ANNUAL_SALARY=0

# Scheduler (Phase 2) — used as fallback if no profile file sets schedule_hour/minute
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0

# Notifications (Phase 2 — optional)
# Uncomment and set to receive a Slack message after each scheduled run
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
